# Mailpit (lokal). Jalankan: mailpit  -> UI di http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Alternatif tanpa Mailpit: email ditulis ke storage/logs/laravel.log
# MAIL_MAILER=log
